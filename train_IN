# ====================== 定义绘图辅助函数 (基模型散点图+残差图) ======================
def plot_base_model(model, model_name, X, y_log):
    y_pred_log = model.predict(X)
    y_true = np.expm1(y_log)
    y_pred = np.expm1(y_pred_log)
    residuals = y_true - y_pred

    # 1. 散点图
    plt.figure(figsize=(8, 8))
    plt.scatter(y_true, y_pred, alpha=0.65, s=12, color='blue', edgecolors='black')
    plt.plot([y_true.min(), y_true.max()], [y_true.min(), y_true.max()], 'r--', lw=2.5)
    plt.xlabel('实测无机氮 (mg/L)')
    plt.ylabel('预测无机氮 (mg/L)')
    plt.title(f'{model_name} 精度散点图\nR² = {r2_score(y_true, y_pred):.4f}')
    plt.grid(True, ls='--', alpha=0.5)
    plt.savefig(f"{save_dir}{model_name}_散点图.png", bbox_inches='tight')
    plt.close()

    # 2. 残差图
    plt.figure(figsize=(10, 6))
    plt.scatter(y_pred, residuals, alpha=0.6, s=12, color='purple', edgecolors='black')
    plt.axhline(y=0, color='red', linestyle='--', lw=2)
    plt.xlabel('预测无机氮 (mg/L)')
    plt.ylabel('残差 (Real - Pred)')
    plt.title(f'{model_name} 残差分布图')
    plt.grid(True, ls='--', alpha=0.5)
    plt.savefig(f"{save_dir}{model_name}_残差图.png", bbox_inches='tight')
    plt.close()
    print(f"{model_name} 图已保存")


