def preprocess_data(df):
    df['无机氮'] = pd.to_numeric(df['无机氮'], errors='coerce')
    key_cols = ['波段1', '波段2', '波段3', '波段4', '波段5', '波段6', '波段7', '无机氮']
    df = df.dropna(subset=key_cols).copy()

    q005, q995 = df['无机氮'].quantile([0.005, 0.995])
    df = df[(df['无机氮'] >= q005) & (df['无机氮'] <= q995)]

    band_cols = ['波段1', '波段2', '波段3', '波段4', '波段5', '波段6', '波段7']
    for col in band_cols:
        median = df[col].median()
        mad = (df[col] - median).abs().median()
        df = df[(df[col] >= median - 8 * mad) & (df[col] <= median + 8 * mad)]

    df['inorg_n_log'] = np.log1p(df['无机氮'])
    print(f"清洗后数据量: {len(df)}")
    return df


data = preprocess_data(data)

# ====================== 2. 特征工程 ======================
data['B1'] = data['波段1']
data['B2'] = data['波段2']
data['B3'] = data['波段3']
data['B4'] = data['波段4']
data['B5'] = data['波段5']
data['B6'] = data['波段6']
data['B7'] = data['波段7']

bands = ['B1', 'B2', 'B3', 'B4', 'B5', 'B6', 'B7']
for i in range(len(bands)):
    for j in range(i + 1, len(bands)):
        data[f'r_{bands[i]}_{bands[j]}'] = data[bands[i]] / (data[bands[j]] + 1e-8)
        data[f'd_{bands[i]}_{bands[j]}'] = data[bands[i]] - data[bands[j]]
        data[f'm_{bands[i]}_{bands[j]}'] = data[bands[i]] * data[bands[j]]

data['NDVI'] = (data['B5'] - data['B4']) / (data['B5'] + data['B4'] + 1e-8)
data['NDWI'] = (data['B5'] - data['B6']) / (data['B5'] + data['B6'] + 1e-8)
data['NDTI'] = (data['B6'] - data['B7']) / (data['B6'] + data['B7'] + 1e-8)
data['EVI'] = 2.5 * (data['B5'] - data['B4']) / (data['B5'] + 6 * data['B4'] - 7.5 * data['B2'] + 1 + 1e-8)
data['FLH'] = data['B5'] - (data['B4'] + (data['B6'] - data['B4']) * (665 - 655) / (740 - 655))

for col in ['B2', 'B3', 'B4', 'B5']:
    data[f'{col}_sq'] = data[col] ** 2
    data[f'{col}_log'] = np.log1p(data[col])

data['B5_B4_ratio'] = data['B5'] / (data['B4'] + 1e-8)
data['B5_B2_ratio'] = data['B5'] / (data['B2'] + 1e-8)
data['B5_B3_ratio'] = data['B5'] / (data['B3'] + 1e-8)

