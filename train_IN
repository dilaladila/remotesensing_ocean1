# ====================== 5. 定义 Optuna objective 函数 ======================
def objective_xgb(trial):
    params = {
        'n_estimators': trial.suggest_int('n_estimators', 2000, 4500),
        'max_depth': trial.suggest_int('max_depth', 6, 10),
        'learning_rate': trial.suggest_float('learning_rate', 0.008, 0.03, log=True),
        'subsample': trial.suggest_float('subsample', 0.7, 0.95),
        'colsample_bytree': trial.suggest_float('colsample_bytree', 0.7, 0.95),
        'reg_alpha': trial.suggest_float('reg_alpha', 1, 20),
        'reg_lambda': trial.suggest_float('reg_lambda', 1, 20),
        'random_state': 42,
        'n_jobs': -1
    }
    model = XGBRegressor(**params, verbosity=0)
    kf = KFold(n_splits=5, shuffle=True, random_state=42)
    scores = []
    for tr_idx, val_idx in kf.split(X_selected):
        model.fit(X_selected[tr_idx], y.iloc[tr_idx])
        pred = model.predict(X_selected[val_idx])
        scores.append(r2_score(np.expm1(y.iloc[val_idx]), np.expm1(pred)))
    return np.mean(scores)


def objective_lgb(trial):
    params = {
        'n_estimators': trial.suggest_int('n_estimators', 2000, 4500),
        'max_depth': trial.suggest_int('max_depth', 6, 10),
        'learning_rate': trial.suggest_float('learning_rate', 0.008, 0.03, log=True),
        'subsample': trial.suggest_float('subsample', 0.7, 0.95),
        'colsample_bytree': trial.suggest_float('colsample_bytree', 0.7, 0.95),
        'reg_alpha': trial.suggest_float('reg_alpha', 1, 20),
        'reg_lambda': trial.suggest_float('reg_lambda', 1, 20),
        'random_state': 42,
        'n_jobs': -1
    }
    model = LGBMRegressor(**params, verbosity=-1)
    kf = KFold(n_splits=5, shuffle=True, random_state=42)
    scores = []
    for tr_idx, val_idx in kf.split(X_selected):
        model.fit(X_selected[tr_idx], y.iloc[tr_idx])
        pred = model.predict(X_selected[val_idx])
        scores.append(r2_score(np.expm1(y.iloc[val_idx]), np.expm1(pred)))
    return np.mean(scores)


def objective_cat(trial):
    params = {
        'iterations': trial.suggest_int('iterations', 2500, 4500),
        'depth': trial.suggest_int('depth', 6, 10),
        'learning_rate': trial.suggest_float('learning_rate', 0.008, 0.028, log=True),
        'l2_leaf_reg': trial.suggest_float('l2_leaf_reg', 1, 25),
        'random_strength': trial.suggest_float('random_strength', 1, 12),
        'bagging_temperature': trial.suggest_float('bagging_temperature', 0.5, 2.5),
        'min_data_in_leaf': trial.suggest_int('min_data_in_leaf', 1, 30),
        'random_state': 42,
        'verbose': 0,
        'thread_count': -1
    }
    model = CatBoostRegressor(**params)
    kf = KFold(n_splits=5, shuffle=True, random_state=42)
    scores = []
    for tr_idx, val_idx in kf.split(X_selected):
        model.fit(X_selected[tr_idx], y.iloc[tr_idx], verbose=False)
        pred = model.predict(X_selected[val_idx])
        scores.append(r2_score(np.expm1(y.iloc[val_idx]), np.expm1(pred)))
    return np.mean(scores)


