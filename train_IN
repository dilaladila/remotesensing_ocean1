# ====================== 7. Stacking ======================
# 注意：这里保留你原有的代码逻辑不变
xgb_model = XGBRegressor(**best_xgb, random_state=42, n_jobs=-1, verbosity=0)
lgb_model = LGBMRegressor(**best_lgb, random_state=42, n_jobs=-1, verbosity=-1)
cat_model = CatBoostRegressor(**best_cat, random_state=42, verbose=0, thread_count=-1)

print("\n使用最优参数训练加权 Stacking 模型...")

kf = KFold(n_splits=5, shuffle=True, random_state=42)
r2_scores = []

for fold, (train_idx, test_idx) in enumerate(kf.split(X_selected), 1):
    X_train, X_test = X_selected[train_idx], X_selected[test_idx]
    y_train, y_test = y.iloc[train_idx], y.iloc[test_idx]

    xgb_model.fit(X_train, y_train, verbose=False)
    lgb_model.fit(X_train, y_train)
    cat_model.fit(X_train, y_train)

    pred_xgb = xgb_model.predict(X_test)
    pred_lgb = lgb_model.predict(X_test)
    pred_cat = cat_model.predict(X_test)

    meta_train = np.column_stack((pred_xgb, pred_lgb, pred_cat))
    meta_model = CatBoostRegressor(iterations=1200, depth=6, learning_rate=0.06, verbose=0, random_state=42)
    meta_model.fit(meta_train, y_test)

    pred_meta = meta_model.predict(meta_train)
    pred_orig = np.expm1(pred_meta)
    y_test_orig = np.expm1(y_test)

    r2 = r2_score(y_test_orig, pred_orig)
    r2_scores.append(r2)

    # 实时生成该折散点图
    plt.figure(figsize=(8, 8))
    plt.scatter(y_test_orig, pred_orig, alpha=0.65, s=12, color='blue', edgecolors='black')
    plt.plot([y_test_orig.min(), y_test_orig.max()], [y_test_orig.min(), y_test_orig.max()], 'r--', lw=2.5)
    plt.xlabel('实测无机氮 (mg/L)')
    plt.ylabel('预测无机氮 (mg/L)')
    plt.title(f'Fold {fold} 散点图\nR² = {r2:.4f}')
    plt.grid(True, ls='--', alpha=0.5)
    plt.savefig(f"{save_dir}Fold_{fold}_散点图.png", bbox_inches='tight')
    plt.close()

    print(f"Fold {fold} → R²: {r2:.4f} （散点图已保存）")

print(f"\n最终平均 R² : {np.mean(r2_scores):.4f} ± {np.std(r2_scores):.4f}")

